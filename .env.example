# Optional settings. Copy this file to .env and fill in what you need.

# Real verification emails via https://resend.com (leave empty for demo mode: code shown on screen).
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend. The default test sender only delivers to your own Resend account email.
EMAIL_FROM="LeaveDesk <onboarding@resend.dev>"

# PORT=3000
# JWT_SECRET=change-me

# Optional AI assistant via Groq (free key at https://console.groq.com). Empty = AI features hidden.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
