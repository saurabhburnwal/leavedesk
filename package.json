{
  "name": "leave-management-system",
  "version": "1.0.0",
  "description": "Employee Leave Management System with a multi-level approval workflow (Employee -> Manager -> HOD).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix client --no-audit --no-fund",
    "build": "npm run build --prefix client",
    "start": "npm run build && npm run serve",
    "serve": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "dev": "concurrently -n api,web -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/src/index.js\" \"npm run dev --prefix client\"",
    "reset": "node --disable-warning=ExperimentalWarning server/src/db/reset.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1"
  }
}
